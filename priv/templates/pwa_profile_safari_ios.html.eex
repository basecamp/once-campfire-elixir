    <details class="notifications-help pwa__instructions hide-in-pwa" data-controller="pwa-install" data-pwa-install-prompting-class="pwa--can-install" data-notifications-target="details">
    <summary class="btn">
      <img aria-hidden="true" src="<%= Assets.path("external/install.svg") %>" width="20" height="20" />
      <strong>Install Campfire as a web app.</strong>
      <img aria-hidden="true" class="disclosure" src="<%= Assets.path("disclosure.svg") %>" width="10" height="10" />
    </summary>

        <p>To receive push notifications in <%= @browser %> for <%= @os %>, you must install Campfire as a web app.</p>
        <ol>
          <li>Tap <em><img alt="the share button" src="<%= Assets.path("external/share.svg") %>" width="20" height="20" /></em></li>
          <li>Tap <em>Add to Home Screen</em>.</li>
        </ol>

    <div class="margin-block-start txt-align-center pwa__installer">
      <hr class="separator margin-block">
      <button class="btn btn--reversed center" data-action="pwa-install#promptInstall">
        <img aria-hidden="true" src="<%= Assets.path("external/install.svg") %>" />
        Install now
      </button>
    </div>
  </details>


