    <fieldset class="gap max-width pad border border-radius">
      <legend class="min-width txt-align-start pad-inline">
        <strong class="overflow-ellipsis"><%= @name %></strong>
      </legend>

      <div class="flex align-center gap">
        <img aria-hidden="true" class="colorize--black" src="<%= Assets.path("messages-outlined.svg") %>" width="24" height="24" />

        <div class="flex-item-grow">
          <input type="text" class="input full-width fill-white" value="<%= @text %>" aria-label="curl command for posting messages" readonly>
        </div>

        <div class="txt-small">
          <button class="btn" data-controller="copy-to-clipboard" data-action="copy-to-clipboard#copy" data-copy-to-clipboard-success-class="btn--success" data-copy-to-clipboard-content-value="<%= @text %>">
            <img aria-hidden="true" src="<%= Assets.path("copy-paste.svg") %>" width="20" height="20" />
            <span class="for-screen-reader">Copy message command</span>
</button>        </div>
      </div>

      <div class="flex align-center gap">
        <img aria-hidden="true" class="colorize--black" src="<%= Assets.path("attachment.svg") %>" width="24" height="24" />

        <div class="flex-item-grow">
          <input type="text" class="input full-width fill-white" value="<%= @upload %>" aria-label="curl command for posting attachments" readonly>
        </div>

        <div class="txt-small">
          <button class="btn" data-controller="copy-to-clipboard" data-action="copy-to-clipboard#copy" data-copy-to-clipboard-success-class="btn--success" data-copy-to-clipboard-content-value="<%= @upload %>">
            <img aria-hidden="true" src="<%= Assets.path("copy-paste.svg") %>" width="20" height="20" />
            <span class="for-screen-reader">Copy attachment command</span>
</button>        </div>
      </div>
    </fieldset>
