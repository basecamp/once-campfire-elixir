        <form class="button_to" method="post" action="/account/logo?v=<%= @account_version %>"><input type="hidden" name="_method" value="delete" /><button class="btn btn--negative txt-small avatar__delete-btn" type="submit">
          <img aria-hidden="true" src="<%= Campfire.Assets.path("minus.svg") %>" width="20" height="20" />
          <span class="for-screen-reader">Delete logo</span>
</button><input type="hidden" name="authenticity_token" value="<%= @token %>" /></form>