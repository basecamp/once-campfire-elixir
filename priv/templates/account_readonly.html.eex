      

<section class="panel txt-align-center flex flex-column gap" style="view-transition-name: account-settings">
    <figure class="account-logo avatar txt-xx-large center"><img alt="Account logo" src="/account/logo?v=<%= @account_version %>" width="300" height="300" /></figure>
    <h1 class="flex-item-grow txt-x-large"><%= @name %></h1>

  <div class="margin-block pad-inline pad-block-start fill-shade border-radius">
    <div class="flex flex-column align-center gap">

  <label class="flex flex-column gap full-width" style="--row-gap: 0.5em">
    <strong id="invite_label" class="invite-label">Share to invite more people</strong>
    <span class="flex align-center gap input input--actor fill-white">
      <img aria-hidden="true" class="colorize--black" src="<%= Campfire.Assets.path("person-add.svg") %>" width="20" height="20" />
      <input type="text" class="input" id="invite_url" value="<%= @invite_url %>" aria-labelledby="invite_label" readonly>
    </span>
  </label>

  <div class="flex align-center gap">
    <a class="btn" data-lightbox-target="image" data-action="lightbox#open" data-lightbox-url-value="/qr_code/<%= @invite_id %>" href="/qr_code/<%= @invite_id %>">
      <span class="for-screen-reader">Show join link QR code</span>
      <img aria-hidden="true" class="colorize--black" src="<%= Campfire.Assets.path("qr-code.svg") %>" width="20" height="20" />
</a>
    <button class="btn" data-controller="copy-to-clipboard" data-action="copy-to-clipboard#copy" data-copy-to-clipboard-success-class="btn--success" data-copy-to-clipboard-content-value="<%= @invite_url %>">
      <span class="for-screen-reader">Copy join link</span>
      <img aria-hidden="true" class="colorize--black" src="<%= Campfire.Assets.path("copy-paste.svg") %>" width="20" height="20" />
</button>
    <button class="btn" hidden="hidden" data-controller="web-share" data-action="web-share#share" data-web-share-url-value="<%= @invite_url %>" data-web-share-text-value="Hit this link to join me in Campfire and start chatting." data-web-share-title-value="Link to join Campfire">
      <span class="for-screen-reader">Share join link</span>
      <img aria-hidden="true" class="colorize--black" src="<%= Campfire.Assets.path("share.svg") %>" width="20" height="20" />
</button>
  </div>
</div>


    <hr class="margin-block separator full-width" style="--border-style: solid">

    <menu class="flex flex-column gap margin-none pad">
      <turbo-frame id="account_users">
        <%= @administrators %>

<%= if @separator, do: ~s(          <hr class="separator full-width" style="--border-style: solid">), else: "" %>

        <%= @members %>
        <%= @next_page %>
      </turbo-frame>
    </menu>
  </div>
</section>



