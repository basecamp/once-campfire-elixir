      

<div class="panel txt-align-center">
  <section class="directs--edit margin-block-end">
<%= @users %>  </section>

  <form class="button_to" method="post" action="<%= @base %>/rooms/directs/<%= @id %>"><input type="hidden" name="_method" value="delete" /><button class="btn btn--negative center" aria-label="Delete Ping" data-turbo-confirm="Are you sure you want to delete this ping and all messages in it? This can’t be undone." type="submit">
    <img aria-hidden="true" src="<%= Assets.path("trash.svg") %>" />
    Ping
</button></form></div>


