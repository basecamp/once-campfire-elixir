      <form class="button_to" method="post" action="/account/users/<%= @id %>"><input type="hidden" name="_method" value="delete" /><button class="btn txt-small flex-item-no-shrink btn--negative" data-turbo-confirm="Are you sure you want to permanently remove this person from the account? This can’t be undone." type="submit">
        <img aria-hidden="true" src="<%= Campfire.Assets.path("minus.svg") %>" width="20" height="20" />
        <span class="for-screen-reader">Delete <%= @name %></span>
</button></form>