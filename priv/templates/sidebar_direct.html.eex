  <a class="direct<%= if @unread, do: " unread", else: "" %>" id="list_rooms_direct_<%= @id %>" data-rooms-list-target="room" data-room-id="<%= @id %>" data-badge-dot-target="unread" data-sorted-list-target="item" data-sorted-list-number="<%= @updated %>" href="/rooms/<%= @id %>">
<%= @avatars %>

    <span class="direct__author flex align-center gap max-width min-width border-radius txt-small">
      <span class="txt-nowrap overflow-ellipsis">
        <span class="for-screen-reader">Ping with</span>
          <%= @name %>
      </span>
    </span>
</a>
