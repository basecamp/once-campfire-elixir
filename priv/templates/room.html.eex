<link rel="stylesheet" href="<%= Campfire.Assets.path("nav.css") %>" data-turbo-track="reload" />
<link rel="stylesheet" href="<%= Campfire.Assets.path("panels.css") %>" data-turbo-track="reload" />
<link rel="stylesheet" href="<%= Campfire.Assets.path("separators.css") %>" data-turbo-track="reload" />
