<link rel="stylesheet" href="<%= Campfire.Assets.path("base.css") %>" data-turbo-track="reload" />
<link rel="stylesheet" href="<%= Campfire.Assets.path("boosts.css") %>" data-turbo-track="reload" />
<link rel="stylesheet" href="<%= Campfire.Assets.path("buttons.css") %>" data-turbo-track="reload" />
<link rel="stylesheet" href="<%= Campfire.Assets.path("code.css") %>" data-turbo-track="reload" />
<link rel="stylesheet" href="<%= Campfire.Assets.path("colorize.css") %>" data-turbo-track="reload" />
<link rel="stylesheet" href="<%= Campfire.Assets.path("colors.css") %>" data-turbo-track="reload" />
<link rel="stylesheet" href="<%= Campfire.Assets.path("composer.css") %>" data-turbo-track="reload" />
<link rel="stylesheet" href="<%= Campfire.Assets.path("embeds.css") %>" data-turbo-track="reload" />
<link rel="stylesheet" href="<%= Campfire.Assets.path("filters.css") %>" data-turbo-track="reload" />
<link rel="stylesheet" href="<%= Campfire.Assets.path("flash.css") %>" data-turbo-track="reload" />
<link rel="stylesheet" href="<%= Campfire.Assets.path("inputs.css") %>" data-turbo-track="reload" />
<link rel="stylesheet" href="<%= Campfire.Assets.path("layout.css") %>" data-turbo-track="reload" />
<link rel="stylesheet" href="<%= Campfire.Assets.path("lexxy-content.css") %>" data-turbo-track="reload" />
<link rel="stylesheet" href="<%= Campfire.Assets.path("lexxy-editor.css") %>" data-turbo-track="reload" />
<link rel="stylesheet" href="<%= Campfire.Assets.path("lexxy-variables.css") %>" data-turbo-track="reload" />
