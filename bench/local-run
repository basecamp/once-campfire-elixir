#!/usr/bin/env bash
# Benchmark this checkout natively (no Docker, no Thruster, no cpusets) with the same load
# generator, seed room, routes and validation as bench/run. Results are only comparable with
# other bench/local-run results from the same machine, never with bench/run's container numbers.
#
#   bench/local-run --label NAME [--reps 2] [--out DIR] [--no-build]
#
# Knobs (env): HTTP_SECS=8 HTTP_CONCS="1 16 64" CABLE_CLIENTS="100 500 1000" CABLE_TPUT_SECS=15
#   CABLE_POSTERS=4 SUITES="http cable" PORT=47130 REDIS=1 REDIS_PORT=47179
# REDIS=0 starts the app without REDIS_URL (in-process broadcasts, cache, rate limits and jobs).
# The upload suite needs libvips/ffmpeg and is not run here.
set -euo pipefail

ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
BENCH=$ROOT/bench
LOADGEN=$ROOT/target/bench/release/loadgen
REL=$ROOT/_build/prod/rel/campfire/bin/campfire
HTTP_SECS=${HTTP_SECS:-8}
HTTP_CONCS=${HTTP_CONCS:-1 16 64}
CABLE_CLIENTS=${CABLE_CLIENTS:-100 500 1000}
CABLE_TPUT_SECS=${CABLE_TPUT_SECS:-15}
CABLE_POSTERS=${CABLE_POSTERS:-4}
SUITES=${SUITES:-http cable}
PORT=${PORT:-47130}
REDIS=${REDIS:-1}
REDIS_PORT=${REDIS_PORT:-47179}
BASE=http://127.0.0.1:$PORT
suite() { [[ " $SUITES " = *" $1 "* ]]; }

LABEL="" REPS=2 OUT="" BUILD=1
while [ $# -gt 0 ]; do
  case "$1" in
    --label) LABEL=$2; shift 2 ;;
    --reps) REPS=$2; shift 2 ;;
    --out) OUT=$2; shift 2 ;;
    --no-build) BUILD=0; shift ;;
    *) echo "unknown option $1" >&2; exit 2 ;;
  esac
done
[ -n "$LABEL" ] || { echo "--label is required" >&2; exit 2; }
OUT=${OUT:-$BENCH/results/local/$LABEL}
mkdir -p "$OUT"
WORK=$ROOT/var/bench
log() { echo "[$(date +%T)] $*" >&2; }

# Seed labels (test/fixtures/seed.json: the same rooms and users as the Rust seed's labels.json).
ROOM=486777696          # All Talk: the busy room (131 messages)
WRITE_ROOM=201306877    # HQ: writes go here so the busy room stays put
BEFORE=933434569        # a page in the middle of the busy room
EMAIL=david@37signals.com
PASSWORD=secret123456
set -a; . "$ROOT/parity/reference.env"; set +a

mkdir -p "$ROOT/var/bin"
[ -x "$ROOT/var/bin/campfire-html" ] || cc -O2 -std=c99 -I "$ROOT/native/vendor/gumbo/src" "$ROOT/native/html.c" "$ROOT"/native/vendor/gumbo/src/*.c -o "$ROOT/var/bin/campfire-html"
export PATH=$ROOT/var/bin:$PATH
[ -x "$LOADGEN" ] || (cd "$BENCH/loadgen" && CARGO_TARGET_DIR=$ROOT/target/bench cargo build --release --locked -q)
if [ "$BUILD" = 1 ]; then
  log "building release"
  (cd "$ROOT" && MIX_ENV=prod mix release --overwrite --quiet >/dev/null)
fi
AVATAR=$(cd "$ROOT" && "$REL" eval 'IO.puts(Campfire.Rails.signed_id("User", 149087659, "avatar"))')

APP_PID="" REDIS_PID="" SAMPLER=""
teardown() {
  [ -n "$SAMPLER" ] && kill "$SAMPLER" 2>/dev/null || true
  if [ -n "$APP_PID" ]; then pkill -TERM -P "$APP_PID" 2>/dev/null || true; kill "$APP_PID" 2>/dev/null || true; fi
  [ -n "$REDIS_PID" ] && kill "$REDIS_PID" 2>/dev/null || true
  local waited=0
  while pgrep -f "_build/prod/rel/campfire/.*beam.smp" >/dev/null 2>&1 && [ "$waited" -lt 100 ]; do
    sleep 0.2; waited=$((waited + 1))
  done
  pkill -9 -f "_build/prod/rel/campfire/.*beam.smp" 2>/dev/null || true
  sleep 0.5
}
trap teardown EXIT INT TERM

seed() {
  rm -rf "$WORK"; mkdir -p "$WORK/db" "$WORK/files"
  python3 - "$ROOT" "$WORK" <<'PY'
import base64, hashlib, json, pathlib, sqlite3, sys
root, work = map(pathlib.Path, sys.argv[1:3])
fixture = json.loads((root / "test/fixtures/seed.json").read_text())
with sqlite3.connect(work / "db/production.sqlite3") as db:
    db.executescript(";\n".join(fixture["schema"]) + ";")
    for table, rows in fixture["tables"].items():
        for row in rows:
            names = ",".join('"' + n + '"' for n in row)
            db.execute(f'INSERT INTO "{table}" ({names}) VALUES ({",".join("?" for _ in row)})', list(row.values()))
    db.execute("UPDATE push_subscriptions SET endpoint = 'https://127.0.0.1:9/push/' || id")
    db.execute("UPDATE webhooks SET url = 'http://127.0.0.1:9/hook/' || id")
for blob in fixture["tables"]["active_storage_blobs"]:
    key = blob["key"]; data = (root / "test/fixtures/storage" / key).read_bytes()
    assert len(data) == blob["byte_size"] and base64.b64encode(hashlib.md5(data).digest()).decode() == blob["checksum"]
    target = work / "files" / key[:2] / key[2:4] / key; target.parent.mkdir(parents=True, exist_ok=True); target.write_bytes(data)
PY
}

procstat() { python3 "$BENCH/local-procstat.py" "$APP_PID" ${REDIS_PID:+"$REDIS_PID"}; }
cpu_us() { procstat | python3 -c 'import json,sys; print(json.load(sys.stdin)["cpu_us"])'; }
rss_mb() { procstat | python3 -c 'import json,sys; print(json.load(sys.stdin)["rss_kb"]//1024)'; }

start_app() {
  if [ "$REDIS" = 1 ]; then
    redis-server --port "$REDIS_PORT" --bind 127.0.0.1 --save '' --appendonly no --loglevel warning >"$WORK/redis.log" 2>&1 &
    echo $! > "$WORK/redis.pid"
    for _ in $(seq 1 100); do redis-cli -p "$REDIS_PORT" ping >/dev/null 2>&1 && break; sleep 0.05; done
    redis-cli -p "$REDIS_PORT" flushall >/dev/null
    export REDIS_URL=redis://127.0.0.1:$REDIS_PORT/0
  else
    unset REDIS_URL
  fi
  local t0; t0=$(python3 -c 'import time; print(time.time())')
  env PORT="$PORT" DATABASE_PATH="$WORK/db/production.sqlite3" STORAGE_PATH="$WORK/files" \
    CAMPFIRE_WORKER=1 CAMPFIRE_BIND=loopback APP_URL="$BASE" RAILS_ENV=production \
    CAMPFIRE_GZIP_LEVEL="${CAMPFIRE_GZIP_LEVEL:-1}" \
    "$REL" start >"$WORK/app.log" 2>&1 &
  echo $! > "$WORK/app.pid"
  for _ in $(seq 1 3000); do
    if curl -fsS -o /dev/null "$BASE/up" 2>/dev/null; then break; fi
    sleep 0.02
  done
  curl -fsS -o /dev/null "$BASE/up" || { tail -30 "$WORK/app.log" >&2; return 1; }
  python3 -c "import sys,time; print(round((time.time()-float(sys.argv[1]))*1000))" "$t0"
}

start_sampler() {
  local out=$1
  ( max=0
    while kill -0 "$APP_PID" 2>/dev/null; do
      cur=$(rss_mb 2>/dev/null || echo 0); [ "$cur" -gt "$max" ] && max=$cur
      echo "{\"peak_rss_mb\": $max}" > "$out.tmp" && mv "$out.tmp" "$out"
      sleep 0.2
    done ) &
  SAMPLER=$!
}

jobs_state() {
  if [ "$REDIS" = 1 ]; then
    python3 - "$REDIS_PORT" <<'PY'
import json, socket, sys
s = socket.create_connection(("127.0.0.1", int(sys.argv[1])), timeout=1); f = s.makefile("rb"); out = {}
for name, cmd, key in [("queued", "LLEN", "resque:queue:default"), ("processed", "GET", "resque:stat:processed"), ("failed", "GET", "resque:stat:failed")]:
    args = [cmd, key]; s.sendall(("*2\r\n" + "".join(f"${len(x)}\r\n{x}\r\n" for x in args)).encode()); line = f.readline(); kind = line[:1]; value = int(line[1:])
    if kind == b"$": value = int(f.read(value + 2)[:-2]) if value >= 0 else 0
    out[name] = value
print(json.dumps(out))
PY
  else
    "$REL" rpc 'IO.puts(Jason.encode!(Campfire.LocalQueue.stats()))' 2>/dev/null || echo '{"runtime_queue":"internal"}'
  fi
}

run_rep() {
  local rep=$1 f=$OUT/$LABEL-$rep.json
  seed
  log "$LABEL rep $rep: starting"
  local cold_ms; cold_ms=$(start_app)
  APP_PID=$(cat "$WORK/app.pid"); REDIS_PID=$(cat "$WORK/redis.pid" 2>/dev/null || true)
  sleep 5
  local idle_mb; idle_mb=$(rss_mb)
  start_sampler "$OUT/.$LABEL-$rep.mem"
  log "$LABEL rep $rep: cold start ${cold_ms}ms, idle rss ${idle_mb}MB"

  local cookie scrape csrf streams css
  cookie=$("$LOADGEN" login --base "$BASE" --email "$EMAIL" --password "$PASSWORD" | python3 -c 'import json,sys; print(json.load(sys.stdin)["cookie"])')
  scrape=$("$LOADGEN" scrape --base "$BASE" --cookie "$cookie" --room "$ROOM")
  csrf=$(python3 -c 'import json,sys; print(json.loads(sys.argv[1])["csrf"] or "")' "$scrape")
  streams=$(python3 -c 'import json,sys; print(",".join(json.loads(sys.argv[1])["streams"]))' "$scrape")
  css=$(python3 -c 'import json,sys; print(json.loads(sys.argv[1])["css"])' "$scrape")
  python3 "$BENCH/validate.py" preflight "$BASE" "$cookie" "$ROOM" "$BEFORE" "$AVATAR" "$css" "$WORK/db/production.sqlite3" "$OUT/$LABEL-$rep-validation.json"

  local routes=(
    "room_show|/rooms/$ROOM"
    "messages_page|/rooms/$ROOM/messages?before=$BEFORE"
    "sidebar|/users/me/sidebar"
    "search|/searches?q=coffee"
    "avatar|/users/$AVATAR/avatar"
    "static_css|$css"
    "up|/up"
    "post_message|POST"
  )
  local http_json="[]" r name path args
  suite http || routes=()
  for r in "${routes[@]}"; do
    name=${r%%|*}; path=${r#*|}
    if [ "$path" = POST ]; then args=(--post-room "$WRITE_ROOM" --csrf "$csrf"); else args=(--path "$path"); fi
    "$LOADGEN" http --base "$BASE" --cookie "$cookie" "${args[@]}" --conc 4 --duration 2 >/dev/null # warm up
    for c in $HTTP_CONCS; do
      local cpu_before; cpu_before=$(cpu_us)
      local res; res=$("$LOADGEN" http --base "$BASE" --cookie "$cookie" "${args[@]}" --conc "$c" --duration "$HTTP_SECS")
      local cpu_after; cpu_after=$(cpu_us)
      res=$(python3 -c 'import json,sys; r=json.loads(sys.argv[1]); assert r["errors"]==0 and r.get("invalid_responses",0)==0 and set(r["statuses"])=={"200"}, r; r["cpu_us_per_success"]=(int(sys.argv[3])-int(sys.argv[2]))/r["ok"]; print(json.dumps(r))' "$res" "$cpu_before" "$cpu_after")
      http_json=$(python3 -c 'import json,sys; a=json.loads(sys.argv[1]); r=json.loads(sys.argv[2]); r["route"]=sys.argv[3]; a.append(r); print(json.dumps(a))' "$http_json" "$res" "$name")
      log "$LABEL rep $rep: $name c=$c $(python3 -c 'import json,sys; r=json.loads(sys.argv[1]); print(r["rps"], "rps p50", r["latency"].get("p50_ms"), "p99", r["latency"].get("p99_ms"), "cpu_us", round(r["cpu_us_per_success"]))' "$res")"
    done
  done

  local cable_json="[]" n
  suite cable && CABLE_RUN=$CABLE_CLIENTS || CABLE_RUN=""
  for n in $CABLE_RUN; do
    local res; res=$("$LOADGEN" cable --base "$BASE" --cookie "$cookie" --room "$ROOM" --csrf "$csrf" --streams "$streams" \
      --clients "$n" --tput-secs "$CABLE_TPUT_SECS" --posters "$CABLE_POSTERS" 2>"$OUT/.$LABEL-$rep-cable$n.stderr")
    python3 -c 'import json,sys; r=json.loads(sys.argv[1]); assert r["ready"]==r["clients"] and r["failed"]==0 and r["latency"]["complete"]==r["latency"]["messages"] and r["throughput"]["complete"]==r["throughput"]["posted"],r' "$res"
    cable_json=$(python3 -c 'import json,sys; a=json.loads(sys.argv[1]); a.append(json.loads(sys.argv[2])); print(json.dumps(a))' "$cable_json" "$res")
    log "$LABEL rep $rep: cable $n clients $(python3 -c 'import json,sys; r=json.loads(sys.argv[1]); print("ready", r["ready"], "lat all p50", r["latency"]["all_clients"].get("p50_ms"), "p99", r["latency"]["all_clients"].get("p99_ms"), "tput", r["throughput"]["delivered_msgs_per_sec"], "msg/s", r["throughput"]["complete"], "/", r["throughput"]["posted"])' "$res")"
    sleep 2
  done

  sleep 3
  local jobs; jobs=$(jobs_state)
  local peak; peak=$(cat "$OUT/.$LABEL-$rep.mem")
  kill "$SAMPLER" 2>/dev/null || true; SAMPLER=""
  python3 - "$f" "$LABEL" "$rep" "$cold_ms" "$idle_mb" "$peak" "$http_json" "$cable_json" "$jobs" <<'PY'
import json, sys
f, app, rep, cold, idle, peak, http, cable, jobs = sys.argv[1:]
json.dump({"app": app, "rep": int(rep), "cold_start_ms": int(cold),
           "memory": {"idle_rss_mb": int(idle), **json.loads(peak)},
           "http": json.loads(http), "cable": json.loads(cable), "jobs": json.loads(jobs)}, open(f, "w"), indent=1)
PY
  teardown; APP_PID=""; REDIS_PID=""
  log "$LABEL rep $rep: done -> $f"
}

{
  echo "date: $(date -Iseconds)"
  echo "host: $(uname -sr), $(sysctl -n machdep.cpu.brand_string 2>/dev/null || grep -m1 'model name' /proc/cpuinfo | cut -d: -f2), $(sysctl -n hw.ncpu 2>/dev/null || nproc) threads"
  echo "mode: native release, no Thruster, no Redis container; REDIS=$REDIS CAMPFIRE_GZIP_LEVEL=${CAMPFIRE_GZIP_LEVEL:-1}"
  echo "git: $(git -C "$ROOT" rev-parse --short HEAD) (dirty: $(git -C "$ROOT" status --porcelain -- lib priv/templates mix.exs mix.lock | wc -l | tr -d ' ') files)"
  echo "elixir: $(cd "$ROOT" && elixir --version 2>/dev/null | tail -1)"
  echo "workload: suites=$SUITES HTTP_SECS=$HTTP_SECS HTTP_CONCS=$HTTP_CONCS CABLE_CLIENTS=$CABLE_CLIENTS CABLE_TPUT_SECS=$CABLE_TPUT_SECS CABLE_POSTERS=$CABLE_POSTERS REPS=$REPS"
} > "$OUT/env.txt"

for rep in $(seq 1 "$REPS"); do run_rep "$rep"; done
log "done: $OUT"
