#!/bin/sh
# Profile one workload of an Elixir image on Docker Desktop with eprof; diagnostic only, never a
# benchmark result. Runs bench/docker-desktop/profile-inside in the bench runner container.
#
#   bench/docker-desktop/profile IMAGE ROUTE [SECS]
#
# ROUTE is room_show, messages_page, sidebar, search, post_message, up or cable. The output goes
# to bench/results/profile-macos/ROUTE.txt. The app runs on vCPUs 0-3 and the load generator on
# 4-7, with the populated seed from the sibling once-campfire-rust checkout.
set -eu
ROOT=$(CDPATH= cd -- "$(dirname "$0")/../.." && pwd)
PARENT=$(dirname "$ROOT")
docker build -q -t campfire-bench-runner "$ROOT/bench/docker-desktop" >/dev/null
docker volume inspect campfire-bench-work >/dev/null 2>&1 || docker volume create campfire-bench-work >/dev/null
mkdir -p "$ROOT/bench/results/profile-macos"
exec docker run --rm -i --privileged --network host --pid host \
  -v campfire-bench-work:/work -v /var/run/docker.sock:/var/run/docker.sock -v "$PARENT:$PARENT" \
  -e RUST_ROOT="${RUST_ROOT:-$PARENT/once-campfire-rust}" -w "$ROOT" campfire-bench-runner \
  bash "$ROOT/bench/docker-desktop/profile-inside" "$@"
