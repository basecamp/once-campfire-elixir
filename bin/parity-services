#!/usr/bin/env python3
"""Isolated fixture servers only; never operates on existing deployments."""
import base64,hashlib,json,os,pathlib,shutil,socket,sqlite3,subprocess,sys,time,urllib.request
ROOT=pathlib.Path(__file__).resolve().parents[1]
NAMES={'reference':'campfire-elixir-rails','candidate':'campfire-elixir-candidate','redis':'campfire-elixir-redis'}
PORTS={'reference':47071,'candidate':47070,'redis':47079}
def docker(*args,check=True):
 return subprocess.run(['docker',*map(str,args)],check=check,capture_output=True,text=True)
def stop(side):
 docker('rm','-f',NAMES[side],check=False)
 if side in PORTS:
  for _ in range(100):
   try:
    with socket.create_connection(('127.0.0.1',PORTS[side]),timeout=.05):pass
   except OSError:return
   time.sleep(.05)
  raise SystemExit(f'{side} fixture port {PORTS[side]} remained open after teardown')
def seed(side):
 folder=ROOT/'var'/('rails/db' if side=='reference' else 'candidate')
 folder.mkdir(parents=True,exist_ok=True)
 path=folder/'production.sqlite3'
 for suffix in ['','-shm','-wal']:pathlib.Path(str(path)+suffix).unlink(missing_ok=True)
 fixture=json.loads((ROOT/'test/fixtures/seed.json').read_text())
 files=ROOT/'var'/('rails/files' if side=='reference' else 'candidate/files')
 if files.exists():shutil.rmtree(files)
 files.mkdir(parents=True)
 for blob in fixture['tables']['active_storage_blobs']:
  key=blob['key'];source=ROOT/'test/fixtures/storage'/key
  data=source.read_bytes()
  if len(data)!=blob['byte_size'] or base64.b64encode(hashlib.md5(data).digest()).decode()!=blob['checksum']:raise SystemExit('Fixture byte integrity mismatch: '+key)
  target=files/key[:2]/key[2:4]/key;target.parent.mkdir(parents=True,exist_ok=True);target.write_bytes(data)

 with sqlite3.connect(path) as db:
  db.executescript(';\n'.join(fixture['schema'])+';')
  for table,rows in fixture['tables'].items():
   for row in rows:
    fields=list(row)
    names=','.join('"'+name+'"' for name in fields)
    db.execute(f'INSERT INTO "{table}" ({names}) VALUES ({",".join("?" for _ in fields)})',[row[name] for name in fields])
def start(side):
 stop(side)
 common=['run','-d','--name',NAMES[side],'--network','host']
 if side=='redis':
  docker(*common,'redis:7-alpine','redis-server','--port',PORTS[side],'--bind','127.0.0.1','--save','','--appendonly','no');return
 common+=['--user',f'{os.getuid()}:{os.getgid()}','--env-file',ROOT/'parity/reference.env','-e',f'REDIS_URL=redis://127.0.0.1:{PORTS["redis"]}/0']
 if side=='reference':
  docker(*common,'-e','FAKETIME='+('@' if os.environ.get('CAMPFIRE_PARITY_TICK')=='1' else '')+'2026-03-02 16:00:00','-v',f'{ROOT}/var/rails:/rails/storage','campfire-reference:latest','bin/rails','server','-b','127.0.0.1','-p',PORTS[side])
 else:
  args=[]
  for value in ['HEX_HOME=/app/.hex','MIX_HOME=/app/.mix','HOME=/app','TMPDIR=/app/var/tmp','EXQLITE_USE_SYSTEM=1','DATABASE_PATH=/app/var/candidate/production.sqlite3','STORAGE_PATH=/app/var/candidate/files','CAMPFIRE_CABLE_REDIS_BRIDGE=1','CAMPFIRE_CLOCK=2026-03-02T16:00:00Z','CAMPFIRE_CLOCK_TICK='+os.environ.get('CAMPFIRE_PARITY_TICK','0'),f'PORT={PORTS[side]}']:args+=['-e',value]
  docker(*common,*args,'-v',f'{ROOT}:/app','-w','/app','campfire-elixir:toolchain','mix','run','--no-halt')
 for _ in range(120):
  try:
   with urllib.request.urlopen(f'http://127.0.0.1:{PORTS[side]}/up',timeout=1) as response:
    if response.status==200:return
  except (OSError,urllib.error.URLError):pass
  time.sleep(.25)
 raise SystemExit(f'{side} failed readiness; inspect docker logs {NAMES[side]}')
if __name__=='__main__':
 action=sys.argv[1] if len(sys.argv)>1 else 'start'
 if action=='start':
  expected=subprocess.check_output(['git','-C',str(ROOT/'reference'),'rev-parse','HEAD'],text=True).strip()
  for image in ['campfire-reference:app','campfire-reference:latest']:
   config=json.loads(docker('image','inspect',image).stdout)[0]['Config']['Env']
   actual=next((value.split('=',1)[1] for value in config if value.startswith('GIT_REVISION=')),None)
   if actual!=expected:raise SystemExit('Reference image revision mismatch: '+image)
  start('redis')
  for side in ['reference','candidate']:seed(side);start(side)
 elif action=='reset' and len(sys.argv)==3 and sys.argv[2] in ['reference','candidate']:
  side=sys.argv[2];stop(side);seed(side);start(side)
  docker('exec',NAMES['redis'],'redis-cli','-p',PORTS['redis'],'FLUSHDB')
 elif action=='stop':
  for side in NAMES:stop(side)
 else:raise SystemExit('usage: bin/parity-services start | reset reference|candidate | stop')
