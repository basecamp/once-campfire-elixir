#!/bin/sh
set -eu
# Without REDIS_URL, broadcasts, fragment caching, rate limits and jobs run in-process.
# Set REDIS_URL to share Resque queues and Action Cable broadcasts with a Rails deployment.
if [ "${CAMPFIRE_JOBS_ADAPTER:-}" != disabled ]; then
  CAMPFIRE_WORKER=${CAMPFIRE_WORKER:-1}
  export CAMPFIRE_WORKER
fi
HTTP_PORT=${HTTP_PORT:-${PORT:-80}}
THRUSTER_STORAGE_PATH=${THRUSTER_STORAGE_PATH:-/rails/storage/thruster}
CAMPFIRE_BIND=loopback
export HTTP_PORT THRUSTER_STORAGE_PATH CAMPFIRE_BIND
exec /usr/local/bin/thrust /campfire/bin/campfire start
